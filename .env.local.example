# Copy to .env.local and fill in. Never commit real values.

# Public site URL (temporary until the production domain is decided)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase project used by the server (Admin SDK).
# Real project: one-bouldering. For local work keep "demo-onebouldering":
# it only talks to the Emulator Suite and can never touch real data.
FIREBASE_PROJECT_ID=demo-onebouldering

# Local Emulator Suite (remove these lines to talk to a real project)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Secret for signing athlete / gym session cookies (generate a long random string)
SESSION_SECRET=

# Firebase Web API key (Project settings → General). Used by the server to sign office staff in
# with Firebase Authentication. Not needed with the Auth Emulator.
FIREBASE_API_KEY=

# Set to 1 once the production domain is fixed. Until then the office QR screen warns that
# the QR URL is temporary (do not print POPs yet).
SITE_DOMAIN_FINAL=
