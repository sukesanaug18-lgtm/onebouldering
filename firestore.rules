rules_version = '2';

// All reads and writes go through the server (Next.js Server Actions /
// Route Handlers and Cloud Functions) using the Admin SDK, which bypasses
// these rules. Browsers get no direct access (CLAUDE.md 2 and 7-3).
// Open specific public read paths here only when a page truly needs
// realtime updates in the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
